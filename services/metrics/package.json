{
  "name": "@nosnocabo/metrics",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply METRICS_DB --local",
    "deploy:staging": "wrangler d1 migrations apply METRICS_DB --remote --env staging && wrangler deploy --env staging",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nosnocabo/contract": "workspace:*",
    "@nosnocabo/ip": "workspace:*",
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261001.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.146.0"
  }
}
