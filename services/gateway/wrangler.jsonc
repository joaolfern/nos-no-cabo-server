{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nnc-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
  },
  "services": [
    { "binding": "CATALOG", "service": "nnc-catalog" },
    { "binding": "VERIFICATION", "service": "nnc-verification" },
    { "binding": "METRICS", "service": "nnc-metrics" },
  ],
  "env": {
    "staging": {
      "name": "nnc-gateway-staging",
      "workers_dev": true,
      "routes": [{ "pattern": "api.nosnocabo.com.br", "custom_domain": true }],
      "vars": {
        "ALLOWED_ORIGINS": "https://nosnocabo.com.br,https://nosnocabo.joaolfern.workers.dev,http://localhost:5173",
      },
      "services": [
        { "binding": "CATALOG", "service": "nnc-catalog-staging" },
        { "binding": "VERIFICATION", "service": "nnc-verification-staging" },
        { "binding": "METRICS", "service": "nnc-metrics-staging" },
      ],
    },
  },
}
