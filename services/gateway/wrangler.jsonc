{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nnc-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
  },
  "services": [{ "binding": "CATALOG", "service": "nnc-catalog" }],
  "ratelimits": [
    {
      "name": "SUBMIT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "PREVIEW_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  "env": {
    "staging": {
      "name": "nnc-gateway-staging",
      "vars": {
        "ALLOWED_ORIGINS": "https://nosnocabo.joaolfern.workers.dev,http://localhost:5173",
      },
      "services": [{ "binding": "CATALOG", "service": "nnc-catalog-staging" }],
      "ratelimits": [
        {
          "name": "SUBMIT_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "PREVIEW_LIMITER",
          "namespace_id": "1004",
          "simple": { "limit": 20, "period": 60 },
        },
      ],
    },
  },
}
