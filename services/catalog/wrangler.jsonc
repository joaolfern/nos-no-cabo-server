{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nnc-catalog",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true },
  // Private: only the gateway reaches it, through a service binding.
  "workers_dev": false,
  "preview_urls": false,
  // TURNSTILE_SECRET and IP_HASH_SALT are secrets: .dev.vars locally, `wrangler secret put` remotely.
  // Report alerts (staging): ALERT_EMAIL sends through Email Routing on nosnocabo.com.br. The
  // recipient, ALERT_TO, is a secret so the owner's address stays out of this public repo; it
  // must be a verified Email Routing destination.
  "vars": { "HOME_URL": "https://nosnocabo.com.br/" },
  "queues": {
    "producers": [
      { "binding": "MODERATION_QUEUE", "queue": "moderation-jobs" },
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nnc-catalog",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "staging": {
      "name": "nnc-catalog-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "HOME_URL": "https://nosnocabo.com.br/",
        "ALERT_FROM": "alertas@nosnocabo.com.br",
      },
      "send_email": [{ "name": "ALERT_EMAIL" }],
      "queues": {
        "producers": [
          { "binding": "MODERATION_QUEUE", "queue": "moderation-jobs-staging" },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nnc-catalog-staging",
          "database_id": "47b0086b-34f2-4053-ad63-8c6c82b03f4b",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
